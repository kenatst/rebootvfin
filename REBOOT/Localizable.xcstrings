    "Permanently Delete": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar permanentemente"
          }
        },
        "de": {
