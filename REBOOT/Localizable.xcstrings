    "Staying with one thing, returning after distraction and rebuilding what you learned can all be trained.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester sur une tâche, revenir après une distraction, approfondir ce que vous apprenez : tout cela peut s'entraîner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecer en una tarea, volver tras una distracción y profundizar lo aprendido se pueden entrenar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Sache bleiben, nach einer Ablenkung zurückkehren, Gelerntes vertiefen – all das lässt sich trainieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restare su una cosa, tornare dopo una distrazione, approfondire ciò che hai imparato: tutto si può allenare."
