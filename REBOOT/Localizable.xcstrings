    },
    "When you start something demanding, how long before you usually feel pulled away?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous commencez une tâche exigeante, au bout de combien de temps vous sentez-vous généralement détourné ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando empiezas algo exigente, ¿cuánto tardas normalmente en sentirte arrastrado a otra cosa?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du etwas Anspruchsvolles beginnst – nach wie lange fühlst du dich meistens abgelenkt?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando inizi qualcosa di impegnativo, dopo quanto tempo di solito ti senti attratto altrove?"
          }
        }
      }
    },
    "Where does your attention break most?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où votre attention se brise-t-elle le plus ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde se rompe más tu atención?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo bricht deine Aufmerksamkeit am häufigsten?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si spezza di più la tua attenzione?"
          }
        }
      }
    },
    "Where the break actually happens, not what bothers you most.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où la rupture se produit vraiment, pas ce qui vous déplaît le plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde ocurre de verdad, no lo que más molesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo der Abbruch wirklich passiert, nicht was dich am meisten stört."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove avviene davvero, non ciò che infastidisce di più."
          }
        }
      }
    },
    "Whether the phone actually pulls you, or something else does.": {
