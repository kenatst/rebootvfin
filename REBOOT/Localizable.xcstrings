    "Your focus session is ready. Take a few uninterrupted minutes to practice.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séance est prête. Prenez quelques minutes sans interruption pour pratiquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión está lista. Toma unos minutos sin interrupciones para practicar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist bereit. Nimm dir ein paar unterbrechungsfreie Minuten zum Üben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione è pronta. Prenditi qualche minuto senza interruzioni per praticare."
          }
        }
      }
    },
    "Your last session felt hard. Today is lighter on purpose — that is how load stays survivable.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dernière séance a été difficile. Aujourd'hui est plus léger à dessein — c'est ainsi que la charge reste soutenable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu última sesión se sintió dura. Hoy es más ligero a propósito: así la carga se mantiene sostenible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Sitzung fühlte sich hart an. Heute ist absichtlich leichter – so bleibt die Last tragbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua ultima sessione è stata pesante. Oggi è più leggera apposta: così il carico resta sostenibile."
          }
        }
      }
    },
    "Your real focus window, measured across sessions.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vraie fenêtre d'attention, mesurée sur plusieurs séances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu verdadera ventana de atención, medida entre sesiones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein echtes Fokusfenster, über Sitzungen hinweg gemessen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua vera finestra di attenzione, misurata sulle sessioni."
          }
        }
      }
    },
    "Your sessions and honest self-reports surface the pulls that actually cost you focus.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos séances et vos réponses honnêtes révèlent les forces qui coûtent vraiment votre attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sesiones y autoinformes sinceros revelan los impulsos que de verdad te cuestan foco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzungen und ehrlichen Selbstauskünfte zeigen die Kräfte, die wirklich Fokus kosten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
