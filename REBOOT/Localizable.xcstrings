          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo cancelación al menos 24 horas antes del fin del ciclo actual en los ajustes de tu ID de Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, sofern nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums in den Apple-ID-Einstellungen gekündigt wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
