    "No miracle. No dopamine detox. Just deliberate practice and better conditions.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de miracle. Pas de « détox dopamine ». Juste une pratique délibérée et de meilleures conditions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada milagroso. Nada de «detox de dopamina». Solo práctica deliberada y mejores condiciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Wunder. Kein Dopamin-Detox. Nur bewusstes Üben und bessere Bedingungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun miracolo. Nessun detox da dopamina. Solo pratica deliberata e condizioni migliori."
          }
        }
      }
    },
