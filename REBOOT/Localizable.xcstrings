    "Focus holds once you're in. Today extends the stretch instead of changing the setup.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le focus tient une fois installé. Aujourd'hui prolonge la séquence au lieu de changer le cadre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El foco se mantiene una vez dentro. Hoy extiende el tramo en lugar de cambiar el entorno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fokus hält, wenn du drin bist. Heute wird die Strecke verlängert statt dem Setup geändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il focus regge una volta dentro. Oggi si allunga il tratto invece di cambiare allestimento."
          }
        }
      }
    },
    "Focus usually holds 30–60 minutes before something pulls.": {
      "extractionState": "manual",
