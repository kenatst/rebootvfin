    "And if only one of these could fully change, which one?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et si une seule de ces choses pouvait totalement changer, laquelle ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y si solo una pudiera cambiar por completo, ¿cuál?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und wenn sich nur eine davon völlig ändern könnte – welche?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E se una sola di queste potesse cambiare del tutto, quale?"
          }
        }
      }
    },
    "And what you repeat becomes easier to repeat.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ce que vous répétez devient plus facile à répéter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y lo que repites se vuelve más fácil de repetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und was du wiederholst, wird leichter zu wiederholen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E ciò che ripeti diventa più facile da ripetere."
          }
        }
      }
    },
