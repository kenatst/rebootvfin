    "Your focus session is ready. Take a few uninterrupted minutes to practice.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séance est prête. Prenez quelques minutes sans interruption pour pratiquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión está lista. Toma unos minutos sin interrupciones para practicar."
          }
        },
        "de": {
