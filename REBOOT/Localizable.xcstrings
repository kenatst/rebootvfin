        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo schema recente è stabile. Usa REBOOT se vuoi allenarti, provare o rivedere."
          }
        }
      }
    },
    "Your sessions and honest self-reports surface the pulls that actually cost you focus.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos séances et vos réponses honnêtes révèlent les forces qui coûtent vraiment votre attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sesiones y autoinformes sinceros revelan los impulsos que de verdad te cuestan foco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzungen und ehrlichen Selbstauskünfte zeigen die Kräfte, die wirklich Fokus kosten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessioni e autovalutazioni oneste rivelano gli impulsi che davvero ti costano concentrazione."
