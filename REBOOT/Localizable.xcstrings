          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passiert meistens, nachdem du abgelenkt wurdest?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una distrazione, cosa succede di solito?"
          }
        }
      }
