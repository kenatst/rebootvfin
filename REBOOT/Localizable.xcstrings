        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente aguantas más de una hora antes de sentirte arrastrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist hältst du über eine Stunde durch, bevor du dich abgelenkt fühlst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito resisti oltre un'ora prima di sentirti attratto altrove."
          }
        }
      }
    },
    "You're training yourself to switch.": {
