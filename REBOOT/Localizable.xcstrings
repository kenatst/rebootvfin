    "You usually expect 15–30 minutes before feeling pulled away.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous tiendez généralement 15 à 30 minutes avant de vous sentir détourné."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente aguantas entre 15 y 30 minutos antes de sentirte arrastrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist hältst du 15–30 Minuten durch, bevor du dich abgelenkt fühlst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito resisti 15–30 minuti prima di sentirti attratto altrove."
          }
        }
      }
    },
    "You usually stay past an hour before feeling pulled away.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous tenez généralement plus d'une heure avant de vous sentir détourné."
          }
