    },
    "Your recent pattern is stable. Use REBOOT if you want to train, test, or review.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton schéma récent est stable. Utilise REBOOT si tu veux t'entraîner, tester ou revoir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu patrón reciente es estable. Usa REBOOT si quieres entrenar, probar o repasar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktuelles Muster ist stabil. Nutze REBOOT, wenn du trainieren, testen oder nachsehen willst."
