    "When the work becomes uncomfortable, what usually happens?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le travail devient inconfortable, que se passe-t-il généralement ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el trabajo se hace incómodo, ¿qué pasa normalmente?"
          }
        },
