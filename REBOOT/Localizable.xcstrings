        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y lo que repites se vuelve más fácil de repetir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und was du wiederholst, wird leichter zu wiederholen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E ciò che ripeti diventa più facile da ripetere."
          }
        }
      }
    },
