    "No streak to protect. Miss a day and the program simply waits.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune série à préserver. Un jour manqué et le programme attend, tout simplement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que perder por fallar un día. El programa simplemente espera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Serie zu verteidigen. Verpasst du einen Tag, wartet das Programm einfach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna serie da proteggere. Se salti un giorno, il programma semplicemente aspetta."
          }
        }
      }
    },
    "None of these stay fixed. Observed evidence outweighs every answer above.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de tout cela n'est figé. Les observations priment sur chaque réponse ci-dessus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto queda fijo. La evidencia observada pesa más que cada respuesta anterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon bleibt fest. Beobachtete Evidenz wiegt schwerer als jede Antwort oben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di questo resta fisso. L'evidenza osservata pesa più di ogni risposta sopra."
          }
        }
      }
    },
